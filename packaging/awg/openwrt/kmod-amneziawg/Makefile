#
# kmod-amneziawg: the AmneziaWG 3.1 kernel module, built against one OpenWrt kernel build.
#
# WayHop's own OpenWrt package Makefile (built by scripts/awg/build-openwrt.sh in the official
# OpenWrt SDK). The module source is GPL-2.0, see its COPYING.
#
# Pins: PKG_VERSION, PKG_SOURCE_VERSION and PKG_RELEASE must equal AWG_KMOD_TAG (without the "v"),
# AWG_KMOD_COMMIT and AWG_PKG_RELEASE in packaging/awg/VERSIONS; build-openwrt.sh refuses to build
# when they differ. PKG_SOURCE_VERSION is the full commit, so the git checkout is content-addressed
# and a moved tag cannot change what is built. PKG_MIRROR_HASH is the sha256 of the tarball the SDK
# packs from that checkout; refresh it with
#   make package/kmod-amneziawg/check FIXUP=1
# after a pin bump (the SDK then also verifies a freshly packed tarball against it).
#
# Dependencies are the ones OpenWrt's kmod-wireguard has (package/kernel/linux/modules/netsupport.mk):
# the module uses the kernel's udp_tunnel and chacha20poly1305/curve25519 library code. The package
# version is "<kernel version>.<PKG_VERSION>-r<PKG_RELEASE>" and it depends on the exact kernel build
# (kernel (=<version>~<vermagic>-r<n>)), both generated by include/kernel.mk.
#
# The module tree at this commit is self-contained (compat/ covers older kernels and the crypto
# library comes from the running kernel), so unlike older AmneziaWG releases it does not need the
# full kernel source copied next to it: it builds against the SDK's prepared kernel tree like any
# out-of-tree module.
#

include $(TOPDIR)/rules.mk
include $(INCLUDE_DIR)/kernel.mk

PKG_NAME:=kmod-amneziawg
PKG_VERSION:=3.1.20260906
PKG_RELEASE:=2

PKG_SOURCE_PROTO:=git
PKG_SOURCE_URL:=https://github.com/amnezia-vpn/amneziawg-linux-kernel-module.git
PKG_SOURCE_VERSION:=4569c4c67f3a57414969260cafbbd04694fbaae0
PKG_MIRROR_HASH:=25a91c7492221291ec8d4ad5672f20c2ed49ec11f0e61478280bf0a37c89b37f

PKG_LICENSE:=GPL-2.0-only
PKG_LICENSE_FILES:=COPYING

include $(INCLUDE_DIR)/package.mk

define KernelPackage/amneziawg
  SUBMENU:=Network Support
  TITLE:=AmneziaWG 3.1 VPN kernel module
  URL:=https://github.com/amnezia-vpn/amneziawg-linux-kernel-module
  DEPENDS:= \
	+kmod-crypto-lib-chacha20poly1305 \
	+kmod-crypto-lib-curve25519 \
	+kmod-udptunnel4 \
	+IPV6:kmod-udptunnel6
  FILES:=$(PKG_BUILD_DIR)/src/amneziawg.ko
  AUTOLOAD:=$(call AutoProbe,amneziawg)
endef

define KernelPackage/amneziawg/description
  AmneziaWG is WireGuard with traffic obfuscation (junk packets, randomised
  headers and paddings, header protection). This is the generation 3.1
  kernel module; configure it with amneziawg-tools (awg, netifd proto
  "amneziawg").
endef

# WIREGUARD_VERSION is what the module reports (modinfo, /sys/module/amneziawg/version, the load
# message). Upstream's version.h still says the tools version, so pass the tag that was built.
define Build/Compile
	+$(KERNEL_MAKE) \
		M="$(PKG_BUILD_DIR)/src" \
		WIREGUARD_VERSION="$(PKG_VERSION)" \
		modules
endef

$(eval $(call KernelPackage,amneziawg))
