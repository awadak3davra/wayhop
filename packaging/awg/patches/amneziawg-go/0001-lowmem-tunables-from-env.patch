index 0000000..25520ea
--- /dev/null
+++ b/device/queueconstants_env_test.go
@@ -0,0 +1,54 @@
+//go:build !android && !ios && !windows
+
+/* SPDX-License-Identifier: MIT
+ *
+ * Startup-tunable buffer cap and queue length (WayHop's low-memory patch).
+ */
+
+package device
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestApplyTunables(t *testing.T) {
+	saved := [4]int{int(PreallocatedBuffersPerPool), QueueOutboundSize, QueueInboundSize, QueueHandshakeSize}
+	defer func() {
+		PreallocatedBuffersPerPool = uint32(saved[0])
+		QueueOutboundSize, QueueInboundSize, QueueHandshakeSize = saved[1], saved[2], saved[3]
+	}()
+	// Upstream's values, whatever the test process itself was started with.
+	upstream := func() {
+		PreallocatedBuffersPerPool = 0
+		QueueOutboundSize, QueueInboundSize, QueueHandshakeSize = 1024, 1024, 1024
+	}
+	for _, c := range []struct {
+		env     map[string]string
+		buffers uint32
+		queue   int
+		set     bool
+		note    string
+	}{
+		{nil, 0, 1024, false, "buffers_per_pool=0 queue_size=1024 (unbounded)"},
+		{map[string]string{"AWG_GO_BUFFERS_PER_POOL": ""}, 0, 1024, false, "(unbounded)"},
+		{map[string]string{"AWG_GO_BUFFERS_PER_POOL": "1024", "AWG_GO_QUEUE_SIZE": "256"}, 1024, 256, true, "buffers_per_pool=1024 queue_size=256"},
+		{map[string]string{"AWG_GO_BUFFERS_PER_POOL": "0"}, 0, 1024, true, "(unbounded)"},
+		{map[string]string{"AWG_GO_BUFFERS_PER_POOL": "100"}, 512, 1024, true, "AWG_GO_BUFFERS_PER_POOL=100 raised to 512"},
+		{map[string]string{"AWG_GO_BUFFERS_PER_POOL": " 2048 "}, 2048, 1024, true, "buffers_per_pool=2048"},
+		{map[string]string{"AWG_GO_BUFFERS_PER_POOL": "-1"}, 0, 1024, true, `AWG_GO_BUFFERS_PER_POOL="-1" ignored`},
+		{map[string]string{"AWG_GO_BUFFERS_PER_POOL": "4294967296"}, 0, 1024, true, "ignored"},
+		{map[string]string{"AWG_GO_QUEUE_SIZE": "4"}, 0, 16, true, "AWG_GO_QUEUE_SIZE=4 raised to 16"},
+		{map[string]string{"AWG_GO_QUEUE_SIZE": "100000"}, 0, 65536, true, "AWG_GO_QUEUE_SIZE=100000 lowered to 65536"},
+		{map[string]string{"AWG_GO_QUEUE_SIZE": "lots"}, 0, 1024, true, `AWG_GO_QUEUE_SIZE="lots" ignored`},
+	} {
+		upstream()
+		summary, set := applyTunables(func(k string) (string, bool) { v, ok := c.env[k]; return v, ok })
+		if PreallocatedBuffersPerPool != c.buffers || QueueOutboundSize != c.queue || QueueInboundSize != c.queue || QueueHandshakeSize != c.queue {
+			t.Errorf("%v: buffers %d, queues %d/%d/%d; want %d, %d", c.env, PreallocatedBuffersPerPool, QueueOutboundSize, QueueInboundSize, QueueHandshakeSize, c.buffers, c.queue)
+		}
+		if set != c.set || !strings.Contains(summary, c.note) {
+			t.Errorf("%v: summary %q set %v; want %q set %v", c.env, summary, set, c.note, c.set)
+		}
+	}
+}
diff --git a/ipc/uapi_unix.go b/ipc/uapi_unix.go
index 79604ee..2a05510 100644
--- a/ipc/uapi_unix.go
+++ b/ipc/uapi_unix.go
@@ -12,6 +12,7 @@ import (
 	"fmt"
 	"net"
 	"os"
+	"path/filepath"
 
 	"golang.org/x/sys/unix"
 )
@@ -28,6 +29,32 @@ const (
 // flag in wireguard-android.
 var socketDirectory = "/var/run/amneziawg"
 
+// envSocketDir overrides socketDirectory at startup (WayHop's low-memory patch); an absolute path
+// only, so the socket never lands relative to wherever the process was started.
+const envSocketDir = "AWG_SOCKET_DIR"
+
+var socketDirectoryNote string
+var socketDirectorySet bool
+
+func init() {
+	d, ok := os.LookupEnv(envSocketDir)
+	if !ok || d == "" {
+		return
+	}
+	socketDirectorySet = true
+	if !filepath.IsAbs(d) {
+		socketDirectoryNote = fmt.Sprintf(" (%s=%q ignored: not an absolute path)", envSocketDir, d)
+		return
+	}
+	socketDirectory = filepath.Clean(d)
+}
+
+// SocketDirectory describes the directory the UAPI sockets are served from; set is false when
+// AWG_SOCKET_DIR was not set, so it is the built-in one.
+func SocketDirectory() (summary string, set bool) {
+	return "socket_dir=" + socketDirectory + socketDirectoryNote, socketDirectorySet
+}
+
 func sockPath(iface string) string {
 	return fmt.Sprintf("%s/%s.sock", socketDirectory, iface)
 }
