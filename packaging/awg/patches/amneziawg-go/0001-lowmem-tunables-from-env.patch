diff --git a/device/queueconstants_env.go b/device/queueconstants_env.go
new file mode 100644
index 0000000..91457aa
--- /dev/null
+++ b/device/queueconstants_env.go
@@ -0,0 +1,91 @@
+//go:build !android && !ios && !windows
+
+/* SPDX-License-Identifier: MIT
+ *
+ * Startup-tunable buffer cap and queue length (WayHop's low-memory patch).
+ */
+
+package device
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+)
+
+const (
+	// envBuffersPerPool caps every buffer pool (PreallocatedBuffersPerPool); 0 is upstream's unbounded.
+	envBuffersPerPool = "AWG_GO_BUFFERS_PER_POOL"
+	// envQueueSize sets the inbound, outbound and handshake queue lengths (upstream 1024).
+	envQueueSize = "AWG_GO_QUEUE_SIZE"
+
+	// The TUN reader and the receive routine of each bind socket (IPv4 and IPv6) hold a whole batch
+	// of message buffers for as long as they run, so a cap must leave at least one more batch in
+	// flight: below that the device stalls waiting for buffers nothing will return.
+	minBuffersPerPool = 4 * conn.IdealBatchSize
+	// minQueueSize keeps the handshake load check (a queue 1/8 full) meaningful.
+	minQueueSize = 16
+	maxQueueSize = 1 << 16
+)
+
+var tunablesSummary string
+var tunablesSet bool
+
+func init() {
+	tunablesSummary, tunablesSet = applyTunables(os.LookupEnv)
+}
+
+// applyTunables sets the pool cap and the queue lengths from the environment, clamped to what the
+// device can run with. Nothing is changed when neither variable is set.
+func applyTunables(lookup func(string) (string, bool)) (string, bool) {
+	var notes []string
+	set := false
+	if v, ok := lookup(envBuffersPerPool); ok && v != "" {
+		set = true
+		n, err := strconv.ParseUint(strings.TrimSpace(v), 10, 32)
+		switch {
+		case err != nil:
+			notes = append(notes, fmt.Sprintf("%s=%q ignored: not a whole number below 2^32", envBuffersPerPool, v))
+		case n != 0 && n < minBuffersPerPool:
+			notes = append(notes, fmt.Sprintf("%s=%d raised to %d", envBuffersPerPool, n, minBuffersPerPool))
+			PreallocatedBuffersPerPool = minBuffersPerPool
+		default:
+			PreallocatedBuffersPerPool = uint32(n)
+		}
+	}
+	if v, ok := lookup(envQueueSize); ok && v != "" {
+		set = true
+		n, err := strconv.ParseUint(strings.TrimSpace(v), 10, 32)
+		size := int(n)
+		switch {
+		case err != nil:
+			notes = append(notes, fmt.Sprintf("%s=%q ignored: not a whole number", envQueueSize, v))
+		case n < minQueueSize:
+			notes = append(notes, fmt.Sprintf("%s=%d raised to %d", envQueueSize, n, minQueueSize))
+			size = minQueueSize
+		case n > maxQueueSize:
+			notes = append(notes, fmt.Sprintf("%s=%d lowered to %d", envQueueSize, n, maxQueueSize))
+			size = maxQueueSize
+		}
+		if err == nil {
+			QueueOutboundSize, QueueInboundSize, QueueHandshakeSize = size, size, size
+		}
+	}
+	summary := fmt.Sprintf("buffers_per_pool=%d queue_size=%d", PreallocatedBuffersPerPool, QueueOutboundSize)
+	if PreallocatedBuffersPerPool == 0 {
+		summary += " (unbounded)"
+	}
+	if len(notes) > 0 {
+		summary += " (" + strings.Join(notes, "; ") + ")"
+	}
+	return summary, set
+}
+
+// Tunables describes the effective pool cap and queue length; set is false when neither
+// variable was set, so the values are upstream's.
+func Tunables() (summary string, set bool) {
+	return tunablesSummary, tunablesSet
+}
diff --git a/device/queueconstants_env_test.go b/device/queueconstants_env_test.go
