WayHop patch for amneziawg-tools v3.1.20260812 (ee0f0a9aa34ff0a0da4b3433b9512781cfe02843).

awg finds a userspace device by its UAPI socket, <dir>/<interface>.sock, where <dir> is fixed at
build time (RUNSTATEDIR/amneziawg). With this patch AWG_SOCKET_DIR, when it holds an absolute path,
names <dir> at run time: the same variable WayHop's amneziawg-go serves its sockets from, so one
setting puts the daemon and awg in the same place whatever either was built with. Unset, empty or
relative, awg uses the compiled-in directory exactly as upstream. A socket path that would not fit
sun_path is refused instead of being truncated.

The same file is applied by scripts/awg/build-awg-static.sh (static awg for Entware) and, as
packaging/awg/openwrt/amneziawg-tools/patches/0001-socket-dir-from-env.patch, by the OpenWrt SDK
build; build-awg-static.sh refuses to build when the two copies differ.

diff --git a/src/ipc-uapi-unix.h b/src/ipc-uapi-unix.h
index fcc47ee..3ba5d67 100644
--- a/src/ipc-uapi-unix.h
+++ b/src/ipc-uapi-unix.h
@@ -6,6 +6,7 @@
 #include <stdbool.h>
 #include <stddef.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 #include <unistd.h>
 #include <dirent.h>
@@ -14,9 +15,18 @@
 #include <sys/stat.h>
 #include <sys/un.h>
 
-#define SOCK_PATH RUNSTATEDIR "/amneziawg/"
+#define SOCK_DIR RUNSTATEDIR "/amneziawg"
 #define SOCK_SUFFIX ".sock"
 
+/* The directory of the userspace sockets: AWG_SOCKET_DIR when it is an absolute path (the variable
+ * WayHop's amneziawg-go serves its sockets from), else the compiled-in one. */
+static const char *sock_dir(void)
+{
+	const char *dir = getenv("AWG_SOCKET_DIR");
+
+	return dir && dir[0] == '/' ? dir : SOCK_DIR;
+}
+
 static FILE *userspace_interface_file(const char *iface)
 {
 	struct stat sbuf;
@@ -27,8 +37,8 @@ static FILE *userspace_interface_file(const char *iface)
 	errno = EINVAL;
 	if (strchr(iface, '/'))
 		goto out;
-	ret = snprintf(addr.sun_path, sizeof(addr.sun_path), SOCK_PATH "%s" SOCK_SUFFIX, iface);
-	if (ret < 0)
+	ret = snprintf(addr.sun_path, sizeof(addr.sun_path), "%s/%s" SOCK_SUFFIX, sock_dir(), iface);
+	if (ret < 0 || (size_t)ret >= sizeof(addr.sun_path))
 		goto out;
 	ret = stat(addr.sun_path, &sbuf);
 	if (ret < 0)
@@ -69,7 +79,8 @@ static bool userspace_has_wireguard_interface(const char *iface)
 
 	if (strchr(iface, '/'))
 		return false;
-	if (snprintf(addr.sun_path, sizeof(addr.sun_path), SOCK_PATH "%s" SOCK_SUFFIX, iface) < 0)
+	ret = snprintf(addr.sun_path, sizeof(addr.sun_path), "%s/%s" SOCK_SUFFIX, sock_dir(), iface);
+	if (ret < 0 || (size_t)ret >= sizeof(addr.sun_path))
 		return false;
 	if (stat(addr.sun_path, &sbuf) < 0)
 		return false;
@@ -96,7 +107,7 @@ static int userspace_get_wireguard_interfaces(struct string_list *list)
 	char *end;
 	int ret = 0;
 
-	dir = opendir(SOCK_PATH);
+	dir = opendir(sock_dir());
 	if (!dir)
 		return errno == ENOENT ? 0 : -errno;
 	while ((ent = readdir(dir))) {
